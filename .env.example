# ---------- 应用 ----------
APP_ENV=local

# ---------- OpenAI 兼容模型（可选） ----------
# 不填 API Key 时自动使用本地规则引擎，所有分析仍可正常完成。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ---------- 运行参数（可选） ----------
MAX_UPLOAD_MB=50
MAX_ROWS=200000
MAX_SHEETS=20
LLM_TIMEOUT_SECONDS=40
LLM_MAX_TOKENS=1200

# 本地默认写入 ./data；Docker Compose 中由 compose 固定为 /app/data。
# DATA_DIR=D:\ai\opencode\工作区\data-analysis-agent\data
# SQLITE_PATH=D:\ai\opencode\工作区\data-analysis-agent\data\analyst.db
